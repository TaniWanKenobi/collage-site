---
// Grape disc behind the photo. The SVG globe is the static fallback; on desktop a live 3D globe
// (scripts/globe.js: perspective wireframe on a 2D canvas, loaded when idle) mounts in the slot and
// hides the fallback once it is drawing.
// empty: just the grape disc (the /printer version puts the ICE3DP model in it instead of the globe).
interface Props { mode: 'desk' | 'phone'; empty?: boolean }
const desk = Astro.props.mode === 'desk';
const empty = !!Astro.props.empty;
---
<div aria-hidden="true" class="globe-disc" style="position: absolute; left: 575px; top: 262px; z-index: 2; width: 400px; height: 400px; border-radius: 50%; background: var(--grape); display: flex; align-items: center; justify-content: center; box-shadow: 0 18px 40px rgba(4,8,3,.55)">
  {!empty && <div class="css-fallback" style="display: flex; align-items: center; justify-content: center">
    <svg width="294" height="294" viewBox="0 0 260 260" fill="none">
      <circle cx="130" cy="130" r="110" stroke="#8F86C0" stroke-width="2"></circle>
      <ellipse cx="130" cy="130" rx="110" ry="38" stroke="#8F86C0" stroke-width="2"></ellipse>
      <ellipse cx="130" cy="130" rx="38" ry="110" stroke="#8F86C0" stroke-width="2"></ellipse>
      <ellipse cx="130" cy="130" rx="110" ry="74" stroke="#8F86C0" stroke-width="2" transform="rotate(32 130 130)"></ellipse>
      <circle cx="222" cy="72" r="9" fill="#C2F970"></circle>
    </svg>
  </div>}
  {desk && !empty && (
    <div class="three-slot" data-three-slot="globe" style="left: 53px; top: 53px; right: auto; bottom: auto; width: 294px; height: 294px">
    </div>
  )}
</div>

<script>
  import { initGlobe } from '../../scripts/globe.js';
  initGlobe();
</script>
