---
// Blog (zoom target "writing"): a halftone hand holding an open book. The .zpanel lies over the open pages,
// so the camera flies into the book and the Blog page fades in there.
// Art: src/assets/collage/book.webp (source: Dreamstime).
import ZoomPage from '../sections/ZoomPage.astro';
import book from '../../assets/collage/book.webp';
interface Props { mode: 'desk' | 'phone' }
const desk = Astro.props.mode === 'desk';
const PANEL_W = 96;
const attrs = desk
  ? { 'data-jump': 'writing', 'data-rot': '-4' }
  : { href: '#sec-writing', 'aria-label': 'Blog' };
const Tag = desk ? 'div' : 'a';
---
<Tag class="zp sticker" {...attrs} style="left: 470px; top: 556px; width: 160px; height: 155px; transform: rotate(-4deg)">
<img src={book.src} alt="" width="160" height="155" draggable="false" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain" />
<div class="zpanel" style="position: absolute; left: 35px; top: 23px; width: 96px; height: 60px">
{desk && <ZoomPage section="writing" panelWidth={PANEL_W} />}
</div>
<span class="mono label-tape" style="left: 84px; top: 116px; transform: rotate(4deg)">BLOG</span>
</Tag>
