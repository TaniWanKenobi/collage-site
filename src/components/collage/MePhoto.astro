---
import { url } from '../../lib/sections';
---
<div class="gr-me" style="position: absolute; left: 765px; top: calc(436px + var(--ey, 0px)); z-index: 3; width: 228px; height: 470px">
  <picture style="display: contents">
    <source srcset={url('tanishq-grape-cut.avif')} type="image/avif">
    <source srcset={url('tanishq-grape-cut.webp')} type="image/webp">
    <img src={url('tanishq-grape-cut.png')} alt="Tanishq" width="288" height="530" decoding="async" fetchpriority="high">
  </picture>
  <span aria-hidden="true" class="mono" style="position: absolute; right: -28px; top: 46px; width: 44px; height: 380px; box-sizing: border-box; background: var(--lime); color: var(--onyx); display: flex; align-items: center; justify-content: center; writing-mode: vertical-rl; font-size: 14px; font-weight: 500; transform: rotate(2deg); box-shadow: 0 10px 22px rgba(4,8,3,.55)">Bayonne, NJ · 11th grade · Hack Club</span>
</div>
