---
// Writing and awards card (zoom target "writing"). Used by both the desktop zoom world and the phone collage.
// The .zpanel is the 16:10 surface the camera zooms into; on desktop the section page lives inside it.
import ZoomPage from '../sections/ZoomPage.astro';
interface Props { mode: 'desk' | 'phone' }
const desk = Astro.props.mode === 'desk';
const PANEL_W = 192;
const attrs = desk
  ? { 'data-jump': 'writing', 'data-rot': '-3' }
  : { href: '#sec-writing', 'aria-label': 'Writing and awards' };
const Tag = desk ? 'div' : 'a';
---
<Tag class="zp" {...attrs} style="left: 1150px; top: 420px; width: 220px; height: 148px; padding: 14px; background-color: var(--grape); color: var(--lime-tint); box-shadow: 0 14px 30px rgba(4,8,3,.55); transform: rotate(-3deg)">
<span aria-hidden="true" class="tape" style="top: -12px; right: 24px; width: 70px; transform: rotate(5deg)"></span>
<div class="zpanel" style="width: 192px; height: 120px; background-color: var(--grape)">
<div class="ruled" data-cover={desk ? 'writing' : undefined} style="position: absolute; inset: 0; box-sizing: border-box; padding-top: 2px">
<span class="mono" style="display: block; font-size: 11px; line-height: 28px; color: var(--lime)">04 · writing + awards</span>
<span style="display: block; font-family: 'Caveat', cursive; font-size: 24px; line-height: 28px">[Post title]</span>
<span style="display: block; font-family: 'Caveat', cursive; font-size: 24px; line-height: 28px">[Award name]</span>
<span style="display: block; font-family: 'Caveat', cursive; font-size: 24px; line-height: 28px">[Post title]</span>
</div>
{desk && <ZoomPage section="writing" panelWidth={PANEL_W} />}
</div>
</Tag>
