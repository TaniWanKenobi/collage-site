---
// The big TANISHQ wordmark. It is the page <h1> on the phone collage; on desktop the intro line is the <h1>.
interface Props { as?: 'h1' | 'p' }
const Tag = Astro.props.as ?? 'p';
---
<Tag aria-hidden={Tag === 'p' ? 'true' : undefined} style="position: absolute; left: 36px; top: 92px; z-index: 1; margin: 0; font-weight: 800; font-size: 270px; line-height: 0.85; letter-spacing: -0.05em; color: var(--lime-tint); white-space: nowrap">TANISHQ</Tag>
