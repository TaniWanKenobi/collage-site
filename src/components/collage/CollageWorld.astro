---
// Everything inside the 1440x900 collage. Rendered twice: once in the desktop zoom stage (mode="desk",
// with the in-world nav, intro and the section pages inside each card) and once as the static phone collage.
import Wordmark from './Wordmark.astro';
import GlobeDisc from './GlobeDisc.astro';
import MePhoto from './MePhoto.astro';
import Polaroid from './Polaroid.astro';
import Ticket from './Ticket.astro';
import PhotoStack from './PhotoStack.astro';
import RuledNote from './RuledNote.astro';
import MapScrap from './MapScrap.astro';
import StickyNote from './StickyNote.astro';
import Stamp from './Stamp.astro';
import Model3D from '../Model3D.astro';
import { url } from '../../lib/sections';
interface Props { mode: 'desk' | 'phone'; center?: 'globe' | 'printer' }
const { mode, center = 'globe' } = Astro.props;
const printer = center === 'printer';
const desk = mode === 'desk';
const NAV = [['projects', 'Work'], ['writing', 'Blog'], ['photos', 'Photos'], ['map', 'Map'], ['guestbook', 'Guestbook']];
---
{desk && (
  <div id="zm-whead" style="position: absolute; left: calc(43px - var(--ex, 0px)); right: calc(43px - var(--ex, 0px)); top: calc(22px - var(--ey, 0px)); height: 44px; display: flex; align-items: center; justify-content: space-between; z-index: 25">
    <a href={url()} data-fly="home" style="font-weight: 800; font-size: 18px; color: var(--lime-tint); text-decoration: none; letter-spacing: -0.01em">Tanishq</a>
    <nav aria-label="Collage" class="mono" style="display: flex; align-items: center; gap: 4px 22px; font-size: 13px">
      {NAV.map(([k, label]) => <a href={url(k)} data-fly={k} style="color: var(--muted); text-decoration: none">{label}</a>)}
      <a href={url('contact')} data-fly="contact" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; background: var(--lime); color: var(--onyx); font-weight: 500; text-decoration: none">Email me</a>
    </nav>
  </div>
)}
<Wordmark as={desk ? 'p' : 'h1'} />
<GlobeDisc mode={mode} empty={printer} />
{printer && <Model3D id="ice3dp" kind={desk ? 'world' : 'poster'} fly="projects" fill={1.05} elev={16} azim={30} style="left: 510px; top: 192px; width: 420px; height: 450px; z-index: 2" />}
<MePhoto />
<p aria-hidden="true" style="position: absolute; right: calc(43px - var(--ex, 0px)); bottom: calc(30px - var(--ey, 0px)); z-index: 4; margin: 0; font-weight: 800; font-size: 150px; line-height: 0.9; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 2px var(--lime); white-space: nowrap; pointer-events: none">makes things.</p>
{desk && (
  <>
    <h1 style="position: absolute; left: calc(43px - var(--ex, 0px)); bottom: calc(36px - var(--ey, 0px)); z-index: 4; margin: 0; max-width: 30ch; font-size: 19px; font-weight: 400; line-height: 1.4; color: var(--lime-tint)">Tanishq, 11th grade in Bayonne, NJ. I build apps, tools, and small hardware projects.</h1>
    <p id="zm-hint" class="mono" style="position: absolute; left: calc(43px - var(--ex, 0px)); bottom: calc(108px - var(--ey, 0px)); z-index: 4; margin: 0; font-size: 14px; color: var(--lime)">scroll to zoom in ↓</p>
  </>
)}
<Polaroid mode={mode} />
<Ticket mode={mode} />
<PhotoStack mode={mode} />
<RuledNote mode={mode} />
<MapScrap mode={mode} />
<StickyNote mode={mode} at={printer ? [400, 410] : undefined} />
<Stamp mode={mode} />
{!printer && <Model3D id="ice3dp" kind={desk ? 'world' : 'poster'} fly="projects" fill={1.1} elev={18} style="left: 300px; top: 318px; width: 240px; height: 280px; z-index: 6" />}
<Model3D id="tamagotchi" kind={desk ? 'world' : 'poster'} fly="projects" elev={30} azim={-40} fill={1.25} style="left: calc(1110px + var(--ex, 0px) * 0.6); top: 520px; width: 245px; height: 235px; z-index: 6" />
