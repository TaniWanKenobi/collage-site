---
// Everything inside the 1440x900 collage. Rendered twice: once in the desktop zoom stage (mode="desk",
// with the in-world nav, intro and the section pages inside each card) and once as the static phone collage.
import Wordmark from './Wordmark.astro';
import GlobeDisc from './GlobeDisc.astro';
import MePhoto from './MePhoto.astro';
import Tagline from './Tagline.astro';
import TamaScreen from './TamaScreen.astro';
import Trophy from './Trophy.astro';
import PhotoStack from './PhotoStack.astro';
import Book from './Book.astro';
import Cassette from './Cassette.astro';
import MapScrap from './MapScrap.astro';
import StickyNote from './StickyNote.astro';
import Stamp from './Stamp.astro';
import SpotifyCard from './SpotifyCard.astro';
import Model3D from '../Model3D.astro';
import { url } from '../../lib/sections';
import site from '../../data/site.json';
interface Props { mode: 'desk' | 'phone'; center?: 'globe' | 'printer' }
const { mode, center = 'globe' } = Astro.props;
const printer = center === 'printer';
const desk = mode === 'desk';
const NAV = [['projects', 'Work'], ['writing', 'Blog'], ['photos', 'Photos'], ['map', 'Map'], ['guestbook', 'Guestbook']];
---
{desk && (
  <div id="zm-whead" style="position: absolute; left: calc(43px - var(--ex, 0px)); right: calc(43px - var(--ex, 0px)); top: calc(22px - var(--ey, 0px)); height: 44px; display: flex; align-items: center; justify-content: space-between; z-index: 25">
    <span></span>
    <nav aria-label="Collage" class="mono" style="display: flex; align-items: center; gap: 4px 22px; font-size: 13px">
      {NAV.map(([k, label]) => <a href={url(k)} data-fly={k} style="color: var(--muted); text-decoration: none">{label}</a>)}
      <a href={url('contact')} data-fly="contact" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 500; text-decoration: none" class="ihb ihb--sm"><span aria-hidden="true" class="ihb-dot"></span><span class="ihb-label">Email me</span><span aria-hidden="true" class="ihb-alt">Email me <span>→</span></span></a>
    </nav>
  </div>
)}
<Wordmark as={desk ? 'p' : 'h1'} />
<GlobeDisc mode={mode} empty={printer} />
{printer && <Model3D id="ice3dp" kind={desk ? 'world' : 'poster'} fly="projects" fill={1.05} elev={16} azim={30} style="left: 478px; top: 192px; width: 420px; height: 450px; z-index: 2" />}
<MePhoto />
<Tagline mode={mode} />
{desk && (
  <>
    <!-- The bio line, with a "more" icon (lucide "info", drawn inline like the repo's other icons): hover, focus or tap
         opens a paper card with the longer bio (text in src/data/site.json "bioLong"). The card opens upward. -->
    <div id="zm-bio" class="bio" style="position: absolute; left: calc(43px - var(--ex, 0px)); bottom: calc(36px - var(--ey, 0px)); max-width: 31ch; font-size: 19px; line-height: 1.4; color: var(--text)">
      <h1 class="bio-line">11th grade in Bayonne, NJ. I build apps, tools, and small hardware&nbsp;<span class="bio-tail">projects.<button type="button" class="bio-more" aria-expanded="false" aria-controls="zm-bio-card" aria-label="More about me"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg></button></span></h1>
      <div id="zm-bio-card" class="bio-card">
        <span class="label-tape mono bio-label" aria-hidden="true">WHO I AM</span>
        {site.bioLong.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </>
)}
<Trophy mode={mode} />
<Cassette />
<PhotoStack mode={mode} />
<Book mode={mode} />
<MapScrap mode={mode} />
<StickyNote mode={mode} at={printer ? [400, 410] : undefined} />
<Stamp mode={mode} />
{desk && <SpotifyCard />}
{!printer && <Model3D id="ice3dp" kind={desk ? 'world' : 'poster'} fly="projects" poster="models/ice3dp-collage.webp" fill={1.1} elev={18} style="left: 286px; top: 270px; width: 240px; height: 280px; z-index: 6" />}
<Model3D id="tamagotchi" kind={desk ? 'world' : 'poster'} fly="projects" morph="projects" upright spin={false} toy poster="models/tamagotchi-front.webp" elev={8} azim={-18} fill={1.15} style="left: calc(1090px + var(--ex, 0px) * 0.6); top: 492px; width: 284px; height: 272px; z-index: 6" />
<TamaScreen mode={mode} />

<script>
  // Bio card: CSS opens it on hover / focus; this adds tap-to-toggle (touch), Escape to close, aria-expanded, and keeps
  // clicks on it from reaching the zoom camera. Event-driven only (no rAF).
  const bio = document.getElementById('zm-bio');
  const more = bio?.querySelector<HTMLButtonElement>('.bio-more');
  if (bio && more) {
    const sync = () => more.setAttribute('aria-expanded', String(!bio.classList.contains('is-shut') && (bio.classList.contains('is-open') || bio.matches(':hover, :focus-within'))));
    bio.addEventListener('click', (e) => e.stopPropagation());
    more.addEventListener('click', () => {
      const open = !(bio.classList.contains('is-open') && !bio.classList.contains('is-shut'));
      bio.classList.toggle('is-open', open);
      bio.classList.remove('is-shut');
      if (!open) { bio.classList.add('is-shut'); more.blur(); }
      sync();
    });
    // Leaving (mouse or focus; not a touch, whose :hover sticks) clears a previous Escape / tap-close, so the next hover opens it again.
    bio.addEventListener('pointerenter', sync);
    bio.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch' && !bio.matches(':focus-within')) bio.classList.remove('is-shut'); sync(); });
    bio.addEventListener('focusin', sync);
    bio.addEventListener('focusout', () => setTimeout(() => { if (!bio.matches(':focus-within')) { bio.classList.remove('is-shut'); bio.classList.remove('is-open'); } sync(); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && more.getAttribute('aria-expanded') === 'true') { bio.classList.remove('is-open'); bio.classList.add('is-shut'); sync(); } });
    document.addEventListener('click', () => { if (bio.classList.contains('is-open')) { bio.classList.remove('is-open'); sync(); } });
  }
</script>
