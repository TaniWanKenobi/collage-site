---
// Places card (zoom target "map"). Used by both the desktop zoom world and the phone collage.
// The .zpanel is the 16:10 surface the camera zooms into; on desktop the section page lives inside it.
import ZoomPage from '../sections/ZoomPage.astro';
import places from '../../data/places.json';
import { cardPos } from '../../lib/map-card';
import { url } from '../../lib/sections';
interface Props { mode: 'desk' | 'phone' }
const desk = Astro.props.mode === 'desk';
const PANEL_W = 240;
const attrs = desk
  ? { 'data-jump': 'map', 'data-rot': '-5' }
  : { href: '#sec-map', 'aria-label': 'Places' };
const Tag = desk ? 'div' : 'a';
// The card is a baked OpenStreetMap image (scripts/map/render-card.mjs); pins come from places.json.
const pins = places.map((p) => ({ ...cardPos(p.lat, p.lng), home: !!p.home })).filter((p) => p.fx > 0 && p.fx < 1 && p.fy > 0 && p.fy < 1);
---
<Tag class="zp" {...attrs} style="left: 836px; top: 590px; width: 240px; height: 150px; box-shadow: 0 14px 30px rgba(4,8,3,.55); transform: rotate(-5deg)">
<div class="zpanel" style="width: 240px; height: 150px; background-color: var(--onyx-2)">
<div class="mapcard" data-cover={desk ? 'map' : undefined} style={`position: absolute; inset: 0; background: var(--onyx) url(${url('map-card.webp')}) center / cover; box-shadow: inset 0 0 0 1px var(--lime)`}>
{pins.map((p) => (
  <span aria-hidden="true" class={p.home ? 'mappin is-home' : 'mappin'} style={`left: ${(p.fx * 100).toFixed(2)}%; top: ${(p.fy * 100).toFixed(2)}%`}></span>
))}
<span aria-hidden="true" class="mapcard-grid"></span>
<span aria-hidden="true" class="mapcredit mono">© OpenStreetMap</span>
</div>
{desk && <ZoomPage section="map" panelWidth={PANEL_W} />}
</div>
</Tag>
