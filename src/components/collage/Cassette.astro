---
// Decoration: a halftone cassette sticker (no zoom target). Move it with the ?edit layout editor.
// Art: src/assets/collage/cassette.webp, cut out with scripts/collage/sticker.mjs (border 0, edge-dots 12).
import cassette from '../../assets/collage/cassette-shadow.webp'; // drop shadow baked in: scripts/collage/bake-sticker-shadow.mjs
---
<div aria-hidden="true" class="sticker-deco" data-edit-name="cassette" style="position: absolute; left: calc(64px - var(--ex, 0px) * 0.6); top: 598px; width: 196px; height: 125px; z-index: 5; transform: rotate(11deg)">
<img class="sticker-art" src={cassette.src} alt="" width="240" height="169" draggable="false" />
</div>
