---
// Say hi card (zoom target "contact"). Used by both the desktop zoom world and the phone collage.
// The .zpanel is the 16:10 surface the camera zooms into; on desktop the section page lives inside it.
import ZoomPage from '../sections/ZoomPage.astro';
interface Props { mode: 'desk' | 'phone' }
const desk = Astro.props.mode === 'desk';
const PANEL_W = 128;
const attrs = desk
  ? { 'data-jump': 'contact', 'data-rot': '-12' }
  : { href: '#sec-contact', 'aria-label': 'Say hi' };
const Tag = desk ? 'div' : 'a';
---
<Tag class="zp" {...attrs} style="left: 1230px; top: 120px; width: 170px; height: 170px; border-radius: 50%; background: var(--onyx); color: var(--lime); box-shadow: inset 0 0 0 3px var(--lime), 0 14px 30px rgba(4,8,3,.55); transform: rotate(-12deg)">
<div class="zpanel" style="position: absolute; left: 21px; top: 45px; width: 128px; height: 80px; background-color: var(--onyx)">
<div data-cover={desk ? 'contact' : undefined} style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px">
<span class="mono" style="font-size: 11px; line-height: 1.2">07 · say hi</span>
<span style="font-weight: 800; font-size: 28px; line-height: 1">EMAIL</span>
<span style="font-weight: 800; font-size: 28px; line-height: 1">ME</span>
</div>
{desk && <ZoomPage section="contact" panelWidth={PANEL_W} />}
</div>
</Tag>
