---
// Timeline card (zoom target "timeline"). Used by both the desktop zoom world and the phone collage.
// The .zpanel is the 16:10 surface the camera zooms into; on desktop the section page lives inside it.
import ZoomPage from '../sections/ZoomPage.astro';
interface Props { mode: 'desk' | 'phone' }
const desk = Astro.props.mode === 'desk';
const PANEL_W = 176;
const attrs = desk
  ? { 'data-jump': 'timeline', 'data-rot': '4' }
  : { href: '#sec-timeline', 'aria-label': 'Timeline' };
const Tag = desk ? 'div' : 'a';
---
<Tag class="zp" {...attrs} style="left: 300px; top: 150px; width: 236px; height: 110px; display: flex; border-radius: 6px; box-shadow: 0 14px 30px rgba(4,8,3,.55); transform: rotate(4deg)">
<div class="zpanel" style="width: 176px; height: 110px; background-color: var(--lime); border-radius: 6px 0 0 6px">
<div data-cover={desk ? 'timeline' : undefined} style="position: absolute; inset: 0; box-sizing: border-box; padding: 16px 18px; display: flex; flex-direction: column; justify-content: space-between; color: var(--onyx)">
<span class="mono" style="font-size: 11px; line-height: 1">ADMIT ONE · 02</span>
<span style="font-weight: 800; font-size: 32px; line-height: 1; letter-spacing: -0.02em">Timeline</span>
</div>
{desk && <ZoomPage section="timeline" panelWidth={PANEL_W} />}
</div>
<span aria-hidden="true" class="mono" style="flex: none; width: 60px; box-sizing: border-box; border-left: 2px dashed var(--onyx); background: var(--lime); color: var(--onyx); border-radius: 0 6px 6px 0; display: flex; align-items: center; justify-content: center; font-size: 12px; writing-mode: vertical-rl">2024→now</span>
</Tag>
