---
// A live 3D model: the transparent .webp poster shows at once, then the shared WebGL runtime
// (src/scripts/model-stage.ts, lazy) draws the .glb into the canvas and the poster fades out.
//   kind="world": a cutout object inside the zoom collage (#zm-world); spins, drag to orbit, a click flies to `fly`.
//   kind="page":  inside a section page in the zoom world; renders only while that page is open.
//   kind="flow":  in normal page flow (phone sections); phones get a "spin in 3D" button instead of autoload.
//   kind="poster": picture only (the phone collage thumbnail).
import models from '../data/models.json';
import { url } from '../lib/sections';
interface Props {
  id: 'ice3dp' | 'tamagotchi';
  kind: 'world' | 'page' | 'flow' | 'poster';
  style?: string;
  fly?: string;
  elev?: number; azim?: number; fill?: number;
  poster?: string;   // override the models.json poster: a still rendered with this slot's exact camera (fov 30, fit = 1/fill,
                     // the slot's aspect), so the live model replaces it with no jump. See scripts/models/README.md.
  upright?: boolean; // stand a flat-lying model up so its top face looks at the camera
  spin?: boolean;    // false: no auto-rotate, a gentle sway around the front instead
  toy?: boolean;     // the Tamagotchi's clickable screen and buttons (src/scripts/tama-toy.ts)
  morph?: string;    // zoom key whose page grows out of this model's screen: the model turns square to the camera on the way in
}
const { id, kind, style = '', fly, elev = 22, azim = 35, fill = 0.9, poster, upright, spin = true, toy, morph } = Astro.props;
const m = models.find((x) => x.id === id)!;
const live = kind !== 'poster';
const label = `${m.title} 3D model`;
---
<div
  class={`m3d m3d--${kind}`}
  style={style}
  data-m3d={live ? kind : undefined}
  data-src={url(m.glb)}
  data-elev={elev} data-azim={azim} data-fill={fill}
  data-fly-to={fly}
  data-upright={upright ? '1' : undefined}
  data-spin={spin ? undefined : '0'}
  data-toy={toy ? '1' : undefined}
  data-morph={morph}
  role={kind === 'world' ? 'link' : undefined}
  tabindex={kind === 'world' ? 0 : undefined}
  aria-label={kind === 'world' ? `${m.title}: open Projects${toy ? '. Press 1, 2 or 3 to use its buttons' : ''}` : undefined}
>
  <img class="m3d-poster" src={url(poster ?? m.poster)} alt={live ? '' : label} width="1200" height="900" decoding="async" draggable="false" loading={kind === 'world' ? 'eager' : 'lazy'} />
  {live && <canvas class="m3d-canvas" role="img" aria-label={`${label}. Drag to rotate.`}></canvas>}
  {kind === 'flow' && <button type="button" class="m3d-load mono" hidden>Spin in 3D</button>}
</div>
{live && <script>import '../scripts/models-boot.js';</script>}

<style>
  .m3d { position: relative; }
  .m3d > img, .m3d > canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .m3d-poster { object-fit: contain; transition: opacity .4s ease; pointer-events: none; user-select: none; }
  .m3d-canvas { opacity: 0; transition: opacity .5s ease; cursor: grab; touch-action: pan-y; }
  .m3d-canvas:active { cursor: grabbing; }
  .m3d.is-live .m3d-canvas { opacity: 1; }
  .m3d.is-live .m3d-poster { opacity: 0; }

  .m3d--world, .m3d--poster { position: absolute; }
  /* World slots: the drop shadow (and the hover glow) is drawn into the canvas by model-stage.ts, not a CSS filter:
     a filter on the composited canvas was re-run by the GPU every scroll frame. The canvas hangs out of the slot by
     the shadow's room (PAD in model-stage.ts) and lets pointers through to the slot, which takes the drags. */
  .m3d--world { cursor: grab; touch-action: none; transition: translate .25s ease; outline-offset: 6px; }
  /* Contain the canvas layer, so the collage pieces painted over the slot's surroundings are not promoted to
     layers of their own for overlapping it. The clip margin leaves room for the drawn shadow (PAD). */
  .m3d--world { isolation: isolate; contain: paint; overflow-clip-margin: 60px; }
  .m3d--world:active { cursor: grabbing; }
  .m3d--world > .m3d-canvas { inset: -28px -34px -60px; width: calc(100% + 68px); height: calc(100% + 88px); pointer-events: none; }
  .m3d--world .m3d-poster { filter: drop-shadow(0 16px 18px rgba(4, 8, 3, .6)); } /* until the live model takes over */
  .m3d--world:hover { translate: 0 -6px; }
  .m3d--world:focus-visible { outline: 3px solid var(--lime); }
  .m3d--poster { filter: drop-shadow(0 16px 18px rgba(4, 8, 3, .6)); }

  .m3d--page, .m3d--flow { width: 100%; aspect-ratio: 16 / 10; border-radius: 4px; background: var(--onyx); }
  .m3d-load { position: absolute; left: 50%; bottom: 12px; translate: -50% 0; min-height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--lime); color: var(--onyx); font-size: 13px; cursor: pointer; }
  .m3d.is-live .m3d-load, .m3d.is-loading .m3d-load { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .m3d--world, .m3d-poster, .m3d-canvas { transition: none; }
    .m3d--world:hover { translate: none; }
  }
</style>
