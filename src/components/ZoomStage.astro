---
// Desktop zoom experience: a tall scroll track with a sticky stage. The camera script (scripts/zoom-camera.js)
// turns scroll position into a camera over the 1440x900 collage world and flies between pieces on click.
import CollageWorld from './collage/CollageWorld.astro';
import { ORDER, NAMES, url } from '../lib/sections';
---
<div class="only-desk">
  <div id="zm-track" style="position: relative; height: 12000px">
    <div id="zm-stage" class="grain" style="position: sticky; top: 0; height: 100vh; overflow: hidden; background-color: var(--onyx)">
      <div id="zm-world" style="position: absolute; left: 0; top: 0; width: 1440px; height: 900px; transform-origin: 0 0; transform: none; --ex: 0px; --ey: 0px">
        <CollageWorld mode="desk" />
      </div>

      <a href={url()} id="zm-home" style="position: absolute; left: 24px; top: 18px; z-index: 30; padding: 6px 14px; border-radius: 999px; background-color: rgba(13,22,11,.85); color: var(--lime-tint); font-weight: 800; font-size: 18px; line-height: 1.4; text-decoration: none">Tanishq</a>

      <div id="zm-hud" style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); z-index: 30; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 2px; border-radius: 999px; background-color: rgba(13,22,11,.85)">
        <span class="mono" id="hud-num" style="font-size: 11px; color: var(--lime-tint)">00</span>
        <div style="display: flex; flex-direction: column">
          {ORDER.map((k, i) => (
            <button type="button" class="hud-dot" data-dot={i} aria-label={`Go to ${NAMES[k]}`} aria-current="false">
              <span class="hud-pip"></span>
              <span class="hud-tip mono" aria-hidden="true"><b>{String(i + 1).padStart(2, '0')}</b> {NAMES[k]}</span>
            </button>
          ))}
        </div>
        <span class="mono" id="hud-name" style="writing-mode: vertical-rl; transform: rotate(180deg); font-size: 11px; color: var(--lime-tint); padding-top: 4px">Collage</span>
      </div>
    </div>
  </div>
  <footer style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 28px 24px; border-top: 1px solid var(--onyx-3)">
    <span class="mono" style="font-size: 12px; color: var(--muted)">© 2026 Tanishq</span>
    <span class="mono" style="font-size: 12px; color: var(--muted)">Bayonne, NJ · Hack Club</span>
  </footer>
</div>

<script>
  import { initZoomCamera } from '../scripts/zoom-camera.js';
  initZoomCamera();
</script>
