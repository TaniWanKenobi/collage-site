---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Model3D from '../Model3D.astro';
import models from '../../data/models.json';
interface Props { back?: boolean }
// Stand-in screenshots (tracked placeholders) for projects that have no `image` yet.
const phShots = Object.values(import.meta.glob<{ default: ImageMetadata }>('../../assets/placeholder/projects/*.jpg', { eager: true })).map((m) => m.default.src);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const TILT = [-1.2, 0.8, -0.4, 1.4, -1, 0.5];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Camera per model in the 16:10 cards (elevation, azimuth in degrees; fill = share of the card's height).
const VIEW = { ice3dp: { elev: 22, azim: 35, fill: 1.06 }, tamagotchi: { elev: 30, azim: 48, fill: 1.1 } };
---
<Section id="projects" label="01 · projects" title="Things I've built" back={Astro.props.back}>
  <p class="mono" style="margin: 0 0 -10px; font-size: 13px; color: var(--muted)">in 3D · drag to rotate</p>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 26px 24px">
    {models.map((m, i) => (
      <article class="proj-card" style={`transform: rotate(${i ? 0.6 : -0.8}deg)`}>
        <span aria-hidden="true" class="proj-tape"></span>
        <Model3D id={m.id as 'ice3dp' | 'tamagotchi'} kind={Astro.props.back ? 'page' : 'flow'} {...VIEW[m.id as keyof typeof VIEW]} />
        <h3 style="margin: 6px 0 0; font-weight: 800; font-size: 24px; line-height: 1.1">{m.title}</h3>
        <p style="margin: 0; font-size: 14px; color: var(--onyx-3)">{m.caption}</p>
        <a class="mono" href={m.repo} style="font-size: 13px; color: var(--grape)">{m.repo.replace('https://', '')} →</a>
      </article>
    ))}
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 26px 24px">
    {projects.map((p, i) => (
      <article class="proj-card" data-ph={p.data.placeholder ? '' : undefined} style={`transform: rotate(${TILT[i % TILT.length]}deg)`}>
        <span aria-hidden="true" class="proj-tape"></span>
        {p.data.image
          ? <img src={`${base}/${p.data.image}`} alt="" class="proj-shot" loading="lazy" />
          : <img src={phShots[i % phShots.length]} alt="" class="proj-shot" loading="lazy" data-ph style="object-fit: cover" />}
        <h3 style="margin: 6px 0 0; font-weight: 800; font-size: 24px; line-height: 1.1">{p.data.title}</h3>
        <p style="margin: 0; font-size: 14px; color: var(--grape)">{p.data.blurb}</p>
        <ul class="tags">{p.data.tags.map((t) => <li class="mono">{t}</li>)}</ul>
      </article>
    ))}
  </div>
</Section>
