---
import Section from './Section.astro';
interface Props { back?: boolean }
// Stamp ring letters (after Magic UI Spinning Text, MIT): each placed round the circle, the ring spins on hover.
const RING = [...'BAYONNE · NJ · '.repeat(3)];
---
<Section id="contact" title="Say hi" back={Astro.props.back}>
<div style="flex: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
<p data-hyper style="margin: 0; font-weight: 800; font-size: clamp(80px, 12vw, 190px); line-height: 0.86; letter-spacing: -0.05em; color: var(--lime)">Say hi.</p>
<p style="margin: 0; max-width: 40ch; font-size: 20px; color: var(--lime-tint)">Email is the best way to reach me.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px">
<a href="#contact" data-ph style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: var(--lime); color: var(--onyx); font-weight: 600; font-size: 18px; text-decoration: none" class="ihb"><span aria-hidden="true" class="ihb-dot"></span><span class="ihb-label">Email me</span><span aria-hidden="true" class="ihb-alt">Email me <span>→</span></span></a>
<a href="https://github.com/TaniWanKenobi" class="mono" style="font-size: 14px; text-underline-offset: 4px">GitHub</a>
<a href="#contact" data-ph class="mono" style="font-size: 14px; text-underline-offset: 4px">LinkedIn</a>
</div>
</div>
<div aria-hidden="true" class="spin-stamp" style="position: relative; width: 240px; height: 240px; border-radius: 50%; border: 4px solid var(--lime); color: var(--lime); display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(-12deg)">
<span class="mono spin-ring" style="font-size: 13px">{RING.map((ch, i) => <span style={`--a: ${(360 / RING.length) * i}deg; --r: -100px`}>{ch}</span>)}</span>
<span style="font-weight: 800; font-size: 48px; line-height: 1">EMAIL</span>
<span style="font-weight: 800; font-size: 48px; line-height: 1">ME</span>
</div>
</div>
</Section>
