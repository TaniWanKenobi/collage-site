---
import Section from './Section.astro';
interface Props { back?: boolean }
---
<Section id="contact" label="07 · say hi" title="Say hi" back={Astro.props.back}>
<div style="flex: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
<p style="margin: 0; font-weight: 800; font-size: clamp(80px, 12vw, 190px); line-height: 0.86; letter-spacing: -0.05em; color: var(--lime)">Say hi.</p>
<p style="margin: 0; max-width: 40ch; font-size: 20px; color: var(--lime-tint)">Email is the best way to reach me.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px">
<a href="#contact" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border-radius: 999px; background: var(--lime); color: var(--onyx); font-weight: 600; font-size: 18px; text-decoration: none">Email me</a>
<a href="#contact" class="mono" style="font-size: 14px; text-underline-offset: 4px">GitHub</a>
<a href="#contact" class="mono" style="font-size: 14px; text-underline-offset: 4px">[LinkedIn]</a>
</div>
</div>
<div aria-hidden="true" style="width: 240px; height: 240px; border-radius: 50%; border: 4px solid var(--lime); color: var(--lime); display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(-12deg)">
<span class="mono" style="font-size: 13px">BAYONNE · NJ</span>
<span style="font-weight: 800; font-size: 48px; line-height: 1">EMAIL</span>
<span style="font-weight: 800; font-size: 48px; line-height: 1">ME</span>
</div>
</div>
</Section>
