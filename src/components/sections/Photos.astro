---
import Section from './Section.astro';
interface Props { back?: boolean }
---
<Section id="photos" label="03 · photos" title="Camera roll" back={Astro.props.back}>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 30px 28px">
<figure style="margin: 0; padding: 10px 10px 12px; background: var(--lime-tint); color: var(--onyx); box-shadow: 0 14px 30px rgba(4,8,3,.5); transform: rotate(-0.4deg)">
<div style="height: 196px; background: var(--grape); display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: var(--lime-tint)">[Photo]</div>
<figcaption style="margin-top: 6px; font-family: 'Caveat', cursive; font-size: 24px; line-height: 1.1">[Caption, place]</figcaption>
</figure>
<figure style="margin: 0; padding: 10px 10px 12px; background: var(--lime-tint); color: var(--onyx); box-shadow: 0 14px 30px rgba(4,8,3,.5); transform: rotate(1.4deg)">
<div style="height: 196px; background: var(--grape-deep); display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: var(--lime-tint)">[Photo]</div>
<figcaption style="margin-top: 6px; font-family: 'Caveat', cursive; font-size: 24px; line-height: 1.1">[Caption, place]</figcaption>
</figure>
