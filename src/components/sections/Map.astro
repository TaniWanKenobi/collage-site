---
// Places: a real pannable world map (Leaflet, loaded only when this page is opened) with a pin per place.
// Clicking a pin (or a row in the list) opens a sticky-note card about that place, under the map. Edit src/data/places.json to add places.
import Section from './Section.astro';
// Leaflet's own CSS is bundled with the page (~3 KB gz): a lazily imported CSS chunk 404s on GitHub Pages.
import 'leaflet/dist/leaflet.css';
import places from '../../data/places.json';
interface Props { back?: boolean }
---
<Section id="map" title="Where I've been" back={Astro.props.back}>
<div class="places">
  <div class="places-main">
  <div class="places-map" data-places-map role="region" aria-label="Map of places">
    <p class="mono places-fallback">loading map…</p>
  </div>
  <div class="places-card" data-places-card hidden>
    <span aria-hidden="true" class="tape" style="top: -12px; left: 40%; width: 80px; transform: rotate(-3deg)"></span>
    <button type="button" class="places-x mono" data-places-close aria-label="Close">×</button>
    <p class="mono places-when" data-f="when"></p>
    <h3 data-f="name"></h3>
    <p class="places-note" data-f="note"></p>
  </div>
  </div>
  <ul class="places-list" data-hover-list>
    {places.map((p) => (
      <li data-ph={p.placeholder ? '' : undefined}><button type="button" data-place={p.id} aria-pressed="false"><span>{p.name}</span><span class="mono">{p.when}</span></button></li>
    ))}
  </ul>
</div>
<script type="application/json" data-places-data set:html={JSON.stringify(places)} />
</Section>

<script>
  import { mountPlaces } from '../../scripts/places-map';
  mountPlaces();
</script>
