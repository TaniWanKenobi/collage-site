---
// Guestbook: visitors leave a name, a message, an optional link and an optional doodle. The site stays static;
// entries live in a Cloudflare Worker + D1 (guestbook-worker/), whose URL comes from PUBLIC_GUESTBOOK_URL.
// Until that is set (or when the Worker can't be reached) the form stays disabled and sample notes show instead.
import Section from './Section.astro';
import '../../styles/guestbook.css';
import samples from '../../data/guestbook-samples.json';
interface Props { back?: boolean }
// Unique per render: the section can be in the DOM twice (zoom page + phone layout), so ids must not collide.
const uid = 'gb' + Math.random().toString(36).slice(2, 8);
const papers = ['is-lime', 'is-grape', 'is-tint'];
const tilts = [0.8, -0.6, 1.4];
const pens = [
  { name: 'Onyx', value: '#0D160B' },
  { name: 'Grape', value: '#564D80' },
  { name: 'Lavender', value: '#8F86C0' },
  { name: 'Lime', value: '#9BD63F' },
];
---
<Section id="guestbook" title="Leave a note" back={Astro.props.back}>
<div class="gb" data-gb>
  <form class="gb-form" data-gb-form novalidate aria-labelledby={`${uid}-h`}>
    <span aria-hidden="true" class="tape" style="top: -12px; left: 38%; width: 92px; transform: rotate(-2.5deg)"></span>
    <h3 class="gb-form-h" id={`${uid}-h`}>Sign the guestbook</h3>
    <p class="mono gb-status" data-gb-status role="status">
      the guestbook isn't connected yet, so these are sample notes. check back soon!
    </p>
    <fieldset class="gb-fields" data-gb-fields disabled>
      <legend class="gb-sr">Your note</legend>
      <div class="gb-field">
        <label for={`${uid}-name`}>Name</label>
        <input id={`${uid}-name`} name="name" type="text" maxlength="40" autocomplete="nickname" required
          aria-describedby={`${uid}-name-err`} />
        <p class="gb-err mono" id={`${uid}-name-err`} data-err="name"></p>
      </div>
      <div class="gb-field">
        <label for={`${uid}-message`}>Message</label>
        <textarea id={`${uid}-message`} name="message" rows="4" maxlength="500" required
          aria-describedby={`${uid}-message-count ${uid}-message-err`}></textarea>
        <p class="gb-hint mono" id={`${uid}-message-count`} data-gb-count>0 / 500</p>
        <p class="gb-err mono" id={`${uid}-message-err`} data-err="message"></p>
      </div>
      <div class="gb-field">
        <label for={`${uid}-link`}>Link <span class="gb-opt mono">(optional)</span></label>
        <input id={`${uid}-link`} name="link" type="url" maxlength="200" placeholder="https://" inputmode="url"
          aria-describedby={`${uid}-link-err`} />
        <p class="gb-err mono" id={`${uid}-link-err`} data-err="link"></p>
      </div>
      <div class="gb-field">
        <p class="gb-label" id={`${uid}-doodle-l`}>Doodle <span class="gb-opt mono">(optional)</span></p>
        <canvas class="gb-canvas" data-gb-canvas width="640" height="400"
          aria-label="Doodle pad: draw with a mouse, pen or finger. Drawing is optional."
          aria-describedby={`${uid}-doodle-err`}></canvas>
        <div class="gb-tools">
          <div class="gb-pens" role="radiogroup" aria-label="Pen colour">
            {pens.map((p, i) => (
              <label class="gb-pen" title={p.name}>
                <input type="radio" name={`${uid}-pen`} value={p.value} checked={i === 0} data-gb-pen />
                <span style={`--pen: ${p.value}`}></span>
                <span class="gb-sr">{p.name}</span>
              </label>
            ))}
          </div>
          <button type="button" class="gb-tool mono" data-gb-undo disabled>undo</button>
          <button type="button" class="gb-tool mono" data-gb-clear disabled>clear</button>
        </div>
        <p class="gb-err mono" id={`${uid}-doodle-err`} data-err="doodle"></p>
      </div>
      <div class="gb-submit-row">
        <button type="submit" class="gb-submit" data-gb-submit>Pin it to the wall</button>
        <p class="gb-err mono" data-err="form" aria-live="polite"></p>
      </div>
    </fieldset>
  </form>

  <div class="gb-wall-wrap">
    <ol class="gb-wall" data-gb-list aria-label="Guestbook notes">
      {samples.map((s, i) => (
        <li class={`gb-note ${papers[i % papers.length]}`} style={`--tilt: ${tilts[i % tilts.length]}deg`} data-ph data-gb-sample>
          <p class="gb-msg">{s.message}</p>
          <div class="gb-meta mono">
            {s.link ? <a href={s.link} rel="nofollow ugc noopener" target="_blank">{s.name}</a> : <span>{s.name}</span>}
            <span>{s.date}</span>
          </div>
        </li>
      ))}
    </ol>
    <p class="mono gb-empty" data-gb-empty hidden>No notes yet. Be the first!</p>
    <button type="button" class="gb-more mono" data-gb-more hidden>load more notes</button>
  </div>
</div>
</Section>

<script>
  import { mountGuestbook } from '../../scripts/guestbook';
  mountGuestbook();
</script>
