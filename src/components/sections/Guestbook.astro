---
import Section from './Section.astro';
interface Props { back?: boolean }
---
<Section id="guestbook" label="06 · guestbook" title="Leave a note" back={Astro.props.back}>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 28px">
<article style="min-height: 240px; padding: 22px; box-sizing: border-box; background: var(--lime); color: var(--onyx); box-shadow: 0 14px 30px rgba(4,8,3,.45); display: flex; flex-direction: column; justify-content: space-between; gap: 12px; transform: rotate(0.8deg)">
<p style="margin: 0; font-family: 'Caveat', cursive; font-size: 32px; line-height: 1.1">[Their message]</p>
<div class="mono" style="display: flex; justify-content: space-between; gap: 12px; font-size: 12px">
<span>[Visitor name]</span>
<span>[Date]</span>
</div>
</article>
<article style="min-height: 240px; padding: 22px; box-sizing: border-box; background: var(--grape); color: var(--lime-tint); box-shadow: 0 14px 30px rgba(4,8,3,.45); display: flex; flex-direction: column; justify-content: space-between; gap: 12px; transform: rotate(-0.4deg)">
<p style="margin: 0; font-family: 'Caveat', cursive; font-size: 32px; line-height: 1.1">[Their message]</p>
<div class="mono" style="display: flex; justify-content: space-between; gap: 12px; font-size: 12px">
<span>[Visitor name]</span>
<span>[Date]</span>
</div>
</article>
<article style="min-height: 240px; padding: 22px; box-sizing: border-box; background: var(--lime-tint); color: var(--onyx); box-shadow: 0 14px 30px rgba(4,8,3,.45); display: flex; flex-direction: column; justify-content: space-between; gap: 12px; transform: rotate(1.4deg)">
<p style="margin: 0; font-family: 'Caveat', cursive; font-size: 32px; line-height: 1.1">[Their message]</p>
<div class="mono" style="display: flex; justify-content: space-between; gap: 12px; font-size: 12px">
<span>[Visitor name]</span>
<span>[Date]</span>
</div>
</article>
</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px">
<button type="button" style="display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border-radius: 999px; background: var(--lime); border: 0; color: var(--onyx); font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-size: 16px; font-weight: 600; cursor: pointer">
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
Sign with GitHub
</button>
<p class="mono" style="margin: 0; font-size: 13px; color: var(--muted)">Leave a note. It shows up here.</p>
</div>
</Section>
