---
// Shared shell for every section page: big title, optional "back to collage" button (desktop zoom pages only).
interface Props { id: string; title: string; back?: boolean }
const { id, title, back = false } = Astro.props;
---
<div class="zs">
  <div class="zs-head">
    <div style="display: flex; flex-direction: column; gap: 6px">
      <h2 class="zs-title">{title}</h2>
    </div>
    {back && <button type="button" data-back={id} class="mono zs-back">← back to collage</button>}
  </div>
  <slot />
</div>
