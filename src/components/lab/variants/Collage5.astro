---
// 05 · Workbench: a cutting mat with the tamagotchi sitting on it like an object on the desk.
import Place from '../Place.astro';
import ModelView from '../ModelView.astro';
import { MODELS } from '../lab';
import Wordmark from '../../collage/Wordmark.astro';
import GlobeDisc from '../../collage/GlobeDisc.astro';
import MePhoto from '../../collage/MePhoto.astro';
import Polaroid from '../../collage/Polaroid.astro';
import Ticket from '../../collage/Ticket.astro';
import PhotoStack from '../../collage/PhotoStack.astro';
import RuledNote from '../../collage/RuledNote.astro';
import MapScrap from '../../collage/MapScrap.astro';
import StickyNote from '../../collage/StickyNote.astro';
import Stamp from '../../collage/Stamp.astro';
interface Props { thumb?: boolean }
const live = !Astro.props.thumb;
const TICKS = Array.from({ length: 13 }, (_, i) => i);
---
<div aria-hidden="true" class="mapgrid" style="position:absolute;left:60px;top:70px;width:1320px;height:780px;border-radius:22px;background-color:var(--onyx-2);box-shadow:inset 0 0 0 2px var(--onyx-3),0 24px 50px rgba(4,8,3,.55);z-index:1"></div>
{TICKS.map((i) => <span aria-hidden="true" class="mono" style={`position:absolute;left:${96 + i * 100}px;top:80px;z-index:2;font-size:12px;color:var(--muted);border-left:1px solid var(--muted);padding-left:4px;height:14px`}>{i * 10}</span>)}
<div aria-hidden="true" style="position:absolute;left:540px;top:520px;width:360px;height:64px;border-radius:50%;background:radial-gradient(ellipse at center,rgba(4,8,3,.65),transparent 70%);z-index:7"></div>
<ModelView k="tamagotchi" left={470} top={190} width={500} height={500} z={8} fill={0.8} elev={30} azim={30} live={live} />
<span class="mono" style="position:absolute;left:610px;top:740px;z-index:9;background:var(--lime);color:var(--onyx);padding:6px 14px;border-radius:4px;letter-spacing:.18em;font-weight:600;transform:rotate(-2deg);box-shadow:0 4px 10px rgba(4,8,3,.5)">TAMAGOTCHI · CAD</span>
<Place k="word" x={720} y={130} s={0.36} z={9}><Wordmark as="p" /></Place>
<Place k="polaroid" x={240} y={250} rot={-10}><Polaroid mode="phone" /></Place>
<Place k="note" x={240} y={560} rot={6}><RuledNote mode="phone" /></Place>
<Place k="ticket" x={1150} y={210} rot={9}><Ticket mode="phone" /></Place>
<Place k="photos" x={1200} y={470} rot={-8}><PhotoStack mode="phone" /></Place>
<Place k="map" x={1160} y={730} rot={4}><MapScrap mode="phone" /></Place>
<Place k="sticky" x={300} y={770} rot={-5} s={0.9}><StickyNote mode="phone" /></Place>
<Place k="stamp" x={470} y={140} rot={12} s={0.7}><Stamp mode="phone" /></Place>
