---
// 06 · Model stickers: both models as die-cut stickers slapped among the cards, on the original layout.
import CollageWorld from '../../collage/CollageWorld.astro';
import ModelView from '../ModelView.astro';
interface Props { thumb?: boolean }
const live = !Astro.props.thumb;
---
<CollageWorld mode="phone" />
<ModelView k="ice3dp" shape="sticker" left={70} top={620} width={250} height={250} rot={-8} z={30} fill={0.82} live={live} />
<ModelView k="tamagotchi" shape="sticker" left={1010} top={300} width={190} height={190} rot={9} z={30} fill={0.8} elev={28} live={live} />
