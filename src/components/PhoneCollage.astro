---
// Phone (<760px): the same collage as a static picture scaled to the screen, then every section stacked.
import CollageWorld from './collage/CollageWorld.astro';
import SectionFor from './sections/SectionFor.astro';
import { ORDER, url } from '../lib/sections';
interface Props { center?: 'globe' | 'printer' }
const { center = 'globe' } = Astro.props;
---
<div class="only-phone">
  <div>
    <header style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px">
      <a href={url()} style="font-weight: 800; font-size: 18px; color: var(--lime-tint); text-decoration: none">Tanishq</a>
      <span class="mono" style="font-size: 12px; color: var(--muted)">Bayonne, NJ</span>
    </header>
    <div style="position: relative; width: 100%; height: 62.5vw; overflow: hidden">
      <div class="grain" id="ph-world" style="position: absolute; left: 0; top: 0; width: 1440px; height: 900px; overflow: hidden; transform-origin: 0 0; transform: scale(0.27); background-color: var(--onyx)">
        <CollageWorld mode="phone" center={center} />
      </div>
    </div>
    {ORDER.map((k) => (
      <div id={`sec-${k}`} style="border-top: 1px solid var(--onyx-3)"><SectionFor section={k} /></div>
    ))}
    <footer style="padding: 24px 16px; border-top: 1px solid var(--onyx-3)">
      <span class="mono" style="font-size: 12px; color: var(--muted)">© 2026 Tanishq</span>
    </footer>
  </div>
</div>
