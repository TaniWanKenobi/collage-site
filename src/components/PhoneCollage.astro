---
// Phone (<760px): the same collage as a static picture scaled to the screen, then every section stacked.
import CollageWorld from './collage/CollageWorld.astro';
import SectionFor from './sections/SectionFor.astro';
import { ORDER, url } from '../lib/sections';
interface Props { center?: 'globe' | 'printer' }
const { center = 'globe' } = Astro.props;
---
<div class="only-phone">
  <div>
    <header style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px">
      <span></span>
    </header>
    <div style="position: relative; width: 100%; height: 62.5vw; overflow: hidden">
      <div class="grain" id="ph-world" style="position: absolute; left: 0; top: 0; width: 1440px; height: 900px; overflow: hidden; transform-origin: 0 0; transform: scale(0.27); background-color: var(--bg)">
        <CollageWorld mode="phone" center={center} />
      </div>
    </div>
    {ORDER.map((k) => (
      <div id={`sec-${k}`} style="border-top: 1px solid var(--line)"><SectionFor section={k} /></div>
    ))}
    <footer style="padding: 24px 16px; border-top: 1px solid var(--line)">
      <span class="mono" style="font-size: 12px; color: var(--muted)">© 2026 Tanishq</span>
      <span class="mono tape-credit" style="display: block; margin-top: 6px">Tape: <a href="https://www.figma.com/community/file/1244631822696699256/tape-collection-free">TAPE Collection FREE</a> by Artsem Pachabut, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></span>
    </footer>
  </div>
</div>
