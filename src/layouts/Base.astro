---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'Tanishq',
  description = 'Tanishq, 11th grade in Bayonne, NJ and part of Hack Club. Scroll to zoom into each piece of the collage: projects, timeline, photos, writing, places, guestbook and contact.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <!-- Self-hosted Latin subsets (see README, "Fonts"): no third-party, render-blocking stylesheet. -->
  <link rel="preload" href={`${base}fonts/bricolage.woff2`} as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={`
@font-face{font-family:'Bricolage Grotesque';font-style:normal;font-weight:400 800;font-display:fallback;src:url(${base}fonts/bricolage.woff2) format('woff2')}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400 500;font-display:swap;src:url(${base}fonts/jbmono.woff2) format('woff2')}
@font-face{font-family:'Caveat';font-style:normal;font-weight:500 700;font-display:swap;src:url(${base}fonts/caveat.woff2) format('woff2')}
`}></style>
</head>
<body>
  <slot />
</body>
</html>
